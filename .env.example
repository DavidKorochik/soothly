# Neon serverless Postgres — used by Drizzle (db:push) and the app at runtime.
DATABASE_URL=

# Model provider for the whole Hebrew pipeline (interview, safety, synthesis, quality, repair).
# Default is OpenAI (gpt-5.1). Set to "anthropic" to run the original Claude lineup instead.
# See lib/models.ts for the per-stage registry.
MODEL_PROVIDER=openai

# OpenAI — the default provider for the whole pipeline (gpt-5.1), AND Hebrew speech-to-text for the
# interview's optional voice dictation (gpt-4o-transcribe). Required unless MODEL_PROVIDER=anthropic
# (transcription always needs it). The audio endpoint is no-train + zero abuse-retention by default;
# we never persist the raw audio. Without this key the mic still appears but transcription returns a
# "type instead" message.
OPENAI_API_KEY=

# Anthropic — only used when MODEL_PROVIDER=anthropic (the fallback lineup: Opus 4.8 + Sonnet 4.6 + Haiku 4.5).
ANTHROPIC_API_KEY=

# Vercel Blob — stores generated PDFs (Step 2+).
BLOB_READ_WRITE_TOKEN=

# Resend — delivers the review link by email (Step 4).
RESEND_API_KEY=

# Public base URL, e.g. https://soothly.vercel.app (used in emailed links).
NEXT_PUBLIC_APP_URL=http://localhost:3000
